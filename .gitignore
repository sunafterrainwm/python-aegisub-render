# Python
__pycache__/
*.py[cod]
# ...except the extension modules built by native/build.py, which are committed
!/src/aegisub_render/**/*.pyd
# virtual environments: .venv (Windows), .venv-linux (WSL), ...
.venv*
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/

# Aegisub source snapshots (reference only; see README)
/reference/

# native build trees (the Windows .pyd files copied into src/aegisub_render/ ARE committed;
# the .so files built elsewhere are not)
/native/builddir/
/native/builddir-*/
/src/aegisub_render/**/*.so
# written by native/build.py --msys2: where the modules it built find their DLLs
/src/aegisub_render/_dll_dirs.txt
/native/subprojects/LuaJIT-*/
/native/subprojects/luajit/
/native/subprojects/packagecache/

# built by scripts/build_exe.py; holds this machine's absolute paths
/aegisub-render.exe

# test scratch output
/tests/_out/
# copies of the Windows fonts the tests use, made under WSL (tests/conftest.py)
/tests/.fonts/
/native/subprojects/.wraplock
.mypy_cache/

# memory-bank/activeContext.md and progress.md are this machine's working notes, not part of the repository
/memory-bank/activeContext.md
/memory-bank/progress.md

# skill eval material (real works' video and subtitles) and other local test packs
/skills-test/
/skills/ass-oped-karaoke/evals/

/skills/ass-oped-karaoke/evals-real/

# 對位工具的音訊／分離／特徵快取（建在作品資料夾裡，可能在任何地方）
.falign-cache/
.align-cache/
